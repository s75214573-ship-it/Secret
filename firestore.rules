rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check auth
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && (
          request.auth.token.email == 's75214573@gmail.com' ||
          request.auth.token.email.matches('(?i)s75214573@gmail.com')
        )) ||
        (request.auth.token.phone_number != null && (
          request.auth.token.phone_number == '+919988776655' ||
          request.auth.token.phone_number == '+91 9988776655'
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      
      match /bets/{betId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /transactions/{txId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /referrals/{referralId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /paymentRequests/{requestId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /wingoRounds/{periodId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /aviatorRounds/{roundId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /globalBets/{betId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /system/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && docId == 'vault');
    }

    match /supportTickets/{ticketId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}
